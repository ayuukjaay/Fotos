<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
    <ImageView
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_menu_camera" />

    <EditText android:id="@+id/etCorreo" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Correo" android:inputType="textEmailAddress" />
    <EditText android:id="@+id/etPass" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Contraseña" android:inputType="textPassword" />
    <Button android:id="@+id/btnLogin" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Iniciar sesión" android:layout_marginTop="16dp" />
    <Button android:id="@+id/btnIrRegistro"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Crear cuenta" />
</LinearLayout>